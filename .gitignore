# Virtual environment
.venv/
venv/
env/

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# Generated route outputs (maps + GPX written by `plan`)
route*.png
route*.gpx

# Web app generated maps/GPX (served from static/out at runtime)
static/out/

# Personal road-notes file (your own ground truth; roads-import recreates a template)
road-notes.txt

# Local credentials / config (these live in ~/.windroute, but ignore here too)
.windroute/
*.env
.env

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Club ride library: raw GPX/TCX stay local (21 MB+); the site only needs the
# built club/club_data.json. Rebuild it with: python -m windroute.cli club-build
club/routes/
